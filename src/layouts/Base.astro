---
import '../styles/global.css';
import {UI,LOCALES,localePrefix,localeFromPath} from '../lib/site-i18n.mjs';
const { title = 'BuddhaConnect · 在日常中遇见智慧', description = '以清晰、温和的方式探索佛教文化、经典与正念生活。' } = Astro.props;
const links = [{name:'首页',href:'/'},{name:'佛学入门',href:'/start/'},{name:'佛教经典',href:'/classics/'},{name:'文章',href:'/articles/'},{name:'搜索',href:'/zh/search/'},{name:'佛教词典',href:'/glossary/'},{name:'关于',href:'/about/'}];
const current = Astro.url.pathname;
const locale = Astro.props.locale ?? localeFromPath(current);
const ui=UI[locale as keyof typeof UI];
const localized=Boolean(Astro.props.locale);
const navLinks=localized?[{name:ui.home,href:localePrefix(locale)+'/'},{name:ui.articles,href:localePrefix(locale)+'/articles/'},{name:ui.search,href:localePrefix(locale)+'/search/'}]:links;
const translationLinks=Astro.props.translationLinks ?? [];
const pagePath = current.replace(/^\/(zh|zh-tw|en)(?=\/|$)/,'');
const switchHref=(lang: string)=>translationLinks.length ? (translationLinks.find((x: {locale:string,url:string})=>x.locale===lang)?.url ?? null) : localePrefix(lang)+(pagePath==='/'?'/' : pagePath);

---
<!doctype html><html lang={locale}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="generator" content={Astro.generator}/><meta name="theme-color" content="#243c35"/><meta name="description" content={description}/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href}/>{translationLinks.map((t: {locale:string,url:string})=><link rel="alternate" hreflang={t.locale} href={new URL(t.url,Astro.site).href}/>)}<title>{title}</title></head>
<body>
<header class="site-header"><div class="wrap nav"><a class="logo" href="/" aria-label="BuddhaConnect 首页"><img class="brand-mark" src="/images/lotus-mark.svg" width="37" height="37" alt=""/><span>Buddha<span class="logo-light">Connect</span></span></a><nav aria-label="主导航">{navLinks.map(link=><a href={link.href} aria-current={current===link.href?'page':undefined}>{link.name}</a>)}</nav><div class="language-switch" aria-label="Language">{LOCALES.map(lang=>switchHref(lang)?<a href={switchHref(lang)} hreflang={lang} aria-current={locale===lang?'true':undefined}>{lang}</a>:<span title={ui.missing}>{lang}</span>)}</div>{!localized&&<a class="nav-cta" href="/start/">开始探索 <span aria-hidden="true">↗</span></a>}</div></header>
<main><slot/></main>
<footer><div class="wrap footer-inner"><div><a class="logo" href="/"><span class="mark">◌</span><span>Buddha<span class="logo-light">Connect</span></span></a><p>让古老的智慧，照见当下的生活。</p></div><div class="footer-links"><a href="/about/">关于我们</a><a href="/articles/">文章</a><a href="/classics/">经典</a></div></div><div class="wrap copyright">© {new Date().getFullYear()} BuddhaConnect · 以尊重与求证的态度分享佛教文化</div></footer>
</body></html>
<style>
.site-header{background:#f8f7f3;border-bottom:1px solid #e9e8e0}.nav{min-height:84px;display:flex;align-items:center;gap:35px}.logo{display:inline-flex;align-items:center;gap:10px;white-space:nowrap;font-family:Georgia,serif;font-size:1.45rem;letter-spacing:-.05em;font-weight:700}.logo-light{font-weight:400}.brand-mark{display:block;flex-shrink:0}.mark{display:grid;place-items:center;border:1px solid #c0a577;border-radius:50%;width:37px;height:37px;color:#b39767;font-size:2rem;line-height:1;font-family:serif}.nav nav{display:flex;align-items:center;gap:23px;margin-left:auto}.nav nav a{font-size:.84rem;color:#58665e}.nav nav a:hover,.nav nav a[aria-current=page]{color:#1d4537}.nav-cta{font-size:.8rem;color:#234b3a;border-bottom:1px solid #a7b3a8;padding-bottom:5px;white-space:nowrap}footer{background:#20382f;color:#eef1e9;padding:54px 0 24px}.footer-inner{display:flex;justify-content:space-between;gap:24px}.footer-inner p{color:#b6c4b9;font-size:.87rem;margin-top:17px}.footer-links{display:flex;gap:25px;font-size:.85rem;color:#c5d0c6}.copyright{margin-top:55px;border-top:1px solid #ffffff24;padding-top:20px;font-size:.75rem;color:#9fb1a5}@media(max-width:980px){.nav{flex-wrap:wrap;padding:15px 0;gap:12px}.nav nav{order:3;width:100%;margin:0;overflow:auto;gap:20px;padding:6px 0}.nav-cta{margin-left:auto}}@media(max-width:480px){.nav nav{gap:15px}.nav nav a{white-space:nowrap}.footer-inner{flex-direction:column}.footer-links{flex-wrap:wrap}}
.language-switch{display:flex;gap:8px;font-size:.72rem;flex-wrap:wrap}.language-switch a[aria-current=true]{font-weight:700;text-decoration:underline}.language-switch span{opacity:.4}</style>
