---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { LOCALES, UI, localeFromPath, localizedPath } from '../lib/site-i18n.mjs';

const locale = Astro.props.locale ?? localeFromPath(Astro.url.pathname);
const typedLocale = locale as keyof typeof UI;
const ui = UI[typedLocale];
const {
  title = `BuddhaConnect · ${ui.home}`,
  description = ui.footerPurpose,
  translationLinks = null,
  noindex = false,
} = Astro.props;
const explicitTranslations = Array.isArray(translationLinks);
const equivalents = explicitTranslations
  ? translationLinks
  : LOCALES.map((target) => ({ locale: target, url: Astro.url.pathname.replace(/^\/(zh|zh-tw|en)(?=\/|$)/, localizedPath(target).replace(/\/$/, '')) }));
const languageLinks = LOCALES.map((target) => {
  const equivalent = equivalents.find((item) => item.locale === target);
  return equivalent ?? { locale: target, url: localizedPath(target), fallback: true };
});
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#173f34" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    {equivalents.map((item) => <link rel="alternate" hreflang={item.locale} href={new URL(item.url, Astro.site).href} />)}
    {equivalents.find((item) => item.locale === 'zh-CN') && <link rel="alternate" hreflang="x-default" href={new URL(equivalents.find((item) => item.locale === 'zh-CN').url, Astro.site).href} />}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{ui.skip}</a>
    <Header locale={typedLocale} currentPath={Astro.url.pathname} languageLinks={languageLinks} />
    <main id="main-content"><slot /></main>
    <Footer locale={typedLocale} />
  </body>
</html>
