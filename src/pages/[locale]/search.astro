---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PageHero from '../../components/PageHero.astro';
import { getCollection } from 'astro:content';
import { LOCALES, LOCALE_PATHS, PAGE_CONTENT, UI, localizedEntry, localizedPath, translationLinksFor } from '../../lib/site-i18n.mjs';
import { articleUrl, publishedArticlesForLocale } from '../../lib/i18n.mjs';
export function getStaticPaths(){ return (LOCALES as Array<keyof typeof LOCALE_PATHS>).map((locale)=>({params:{locale:LOCALE_PATHS[locale]},props:{language:locale}})); }
const language=Astro.props.language as keyof typeof UI; const ui=UI[language]; const page=PAGE_CONTENT[language].search;
const entries:any[]=publishedArticlesForLocale((await getCollection('articles')).map(localizedEntry),language).sort((a:any,b:any)=>b.date.valueOf()-a.date.valueOf());
const categories:string[]=[...new Set<string>(entries.map((article:any)=>String(article.category)))].sort();
---
<Base locale={language} title={`${page.title} · BuddhaConnect`} description={page.description} translationLinks={translationLinksFor('search')}>
  <Breadcrumbs locale={language} items={[{label:ui.home,href:localizedPath(language)},{label:ui.search}]}/><PageHero eyebrow={page.eyebrow} title={page.title} description={page.description} compact/>
  <section class="search-section section"><div class="wrap">
    <form id="site-search" class="search-panel" role="search">
      <label class="query-label" for="query"><span>{ui.search}</span><span class="search-input"><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m16 16 5 5"/></svg><input id="query" type="search" name="q" autocomplete="off" placeholder={ui.searchPlaceholder}/></span></label>
      <label for="category"><span>{ui.category}</span><select id="category" name="category"><option value="">{ui.all}</option>{categories.map((category:string)=><option value={category}>{category}</option>)}</select></label>
      <label for="sort"><span>{ui.sort}</span><select id="sort" name="sort"><option value="relevance">{ui.relevance}</option><option value="newest">{ui.newest}</option><option value="oldest">{ui.oldest}</option><option value="title">{ui.titleSort}</option></select></label>
      <button type="reset">{ui.clear}</button>
    </form>
    <div class="result-summary"><p>{ui.searchHint}</p><p aria-live="polite" aria-atomic="true"><strong id="result-count">{entries.length}</strong> {ui.results}</p></div>
    <div id="no-results" class="search-empty" hidden><span aria-hidden="true">⌕</span><h2>{ui.noResults}</h2><p>{ui.searchHint}</p></div>
    <div id="search-results" class="search-results">{entries.map((article:any)=><article class="search-result" data-title={article.title.toLocaleLowerCase()} data-description={article.description.toLocaleLowerCase()} data-category={article.category} data-date={article.date.toISOString()} data-content={article.searchText.toLocaleLowerCase()}><a href={articleUrl(article)}><div><span>{article.category}</span><time datetime={article.date.toISOString()}>{new Intl.DateTimeFormat(language,{year:'numeric',month:'short',day:'numeric'}).format(article.date)}</time></div><h2>{article.title}</h2><p>{article.description}</p><strong>{ui.read} <i aria-hidden="true">↗</i></strong></a></article>)}</div>
  </div></section>
</Base>
<script>
  const form=document.querySelector<HTMLFormElement>('#site-search');
  const query=document.querySelector<HTMLInputElement>('#query');
  const category=document.querySelector<HTMLSelectElement>('#category');
  const sort=document.querySelector<HTMLSelectElement>('#sort');
  const results=document.querySelector<HTMLElement>('#search-results');
  const items=[...document.querySelectorAll<HTMLElement>('.search-result')];
  const count=document.querySelector<HTMLElement>('#result-count');
  const empty=document.querySelector<HTMLElement>('#no-results');
  const score=(item:HTMLElement,q:string)=>!q?0:(item.dataset.title?.includes(q)?8:0)+(item.dataset.description?.includes(q)?4:0)+(item.dataset.category?.toLocaleLowerCase().includes(q)?3:0)+(item.dataset.content?.includes(q)?1:0);
  function updateSearch(){
    const q=(query?.value??'').trim().toLocaleLowerCase(); const selected=category?.value??''; const order=sort?.value??'relevance';
    const visible=items.filter((item)=>{const matches=(!selected||item.dataset.category===selected)&&(!q||[item.dataset.title,item.dataset.description,item.dataset.category?.toLocaleLowerCase(),item.dataset.content].some((value)=>value?.includes(q)));item.hidden=!matches;return matches;});
    visible.sort((a,b)=>order==='title'?(a.dataset.title??'').localeCompare(b.dataset.title??''):order==='oldest'?(a.dataset.date??'').localeCompare(b.dataset.date??''):order==='newest'?(b.dataset.date??'').localeCompare(a.dataset.date??''):score(b,q)-score(a,q)||(b.dataset.date??'').localeCompare(a.dataset.date??''));
    visible.forEach((item)=>results?.appendChild(item)); if(count)count.textContent=String(visible.length); if(empty)empty.hidden=visible.length!==0;
    const url=new URL(location.href); for(const [key,value] of [['q',query?.value??''],['category',selected],['sort',order==='relevance'?'':order]]){if(value)url.searchParams.set(key,value);else url.searchParams.delete(key);} history.replaceState(null,'',url);
  }
  const initial=new URLSearchParams(location.search); if(query)query.value=initial.get('q')??''; if(category&&[...category.options].some((option)=>option.value===initial.get('category')))category.value=initial.get('category')??''; if(sort&&['relevance','newest','oldest','title'].includes(initial.get('sort')??''))sort.value=initial.get('sort')??'relevance';
  form?.addEventListener('input',updateSearch); form?.addEventListener('change',updateSearch); form?.addEventListener('reset',()=>requestAnimationFrame(updateSearch)); updateSearch();
</script>
<style>.search-section{padding-top:2.5rem}.search-panel{display:grid;grid-template-columns:minmax(18rem,2fr) minmax(10rem,1fr) minmax(10rem,1fr) auto;align-items:end;gap:.8rem;padding:1rem;border:1px solid var(--line);border-radius:var(--radius-lg);background:var(--surface);box-shadow:var(--shadow-sm)}.search-panel label{display:grid;gap:.45rem;color:var(--muted);font-size:.72rem;font-weight:700}.search-panel input,.search-panel select,.search-panel button{width:100%;min-height:3rem;border:1px solid var(--line);border-radius:.6rem;background:white;color:var(--ink)}.search-panel input{border:0;padding:.75rem 1rem .75rem 2.8rem;background:transparent}.search-input{position:relative;display:block;border:1px solid var(--line);border-radius:.6rem}.search-input svg{position:absolute;left:.9rem;top:.9rem;width:1.1rem;fill:none;stroke:var(--muted);stroke-width:1.5}.search-panel select{padding:.65rem .8rem}.search-panel button{padding:.65rem 1rem;background:var(--sage-50);cursor:pointer}.result-summary{display:flex;justify-content:space-between;gap:1rem;margin:1.5rem 0;color:var(--muted);font-size:.78rem}.result-summary p{margin:0}.result-summary strong{color:var(--ink)}.search-results{display:grid;gap:.8rem}.search-result[hidden],.search-empty[hidden]{display:none}.search-result a{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:.4rem 2rem;padding:1.5rem 1.7rem;border:1px solid var(--line);border-radius:var(--radius-md);background:var(--surface);transition:.2s}.search-result a:hover{border-color:var(--sage-300);box-shadow:var(--shadow-sm);transform:translateY(-2px)}.search-result div{grid-column:1/-1;display:flex;justify-content:space-between;color:var(--gold-dark);font-size:.68rem;font-weight:700;text-transform:uppercase}.search-result time{color:var(--muted);font-weight:400;text-transform:none}.search-result h2{margin:.65rem 0 .2rem;font:500 clamp(1.25rem,3vw,1.65rem) var(--font-serif)}.search-result p{margin:0;color:var(--muted);font-size:.86rem;line-height:1.7}.search-result strong{grid-column:2;grid-row:2/4;align-self:center;color:var(--pine);font-size:.78rem}.search-result i{font-style:normal}.search-empty{padding:4rem 1rem;text-align:center;border:1px dashed var(--sage-300);border-radius:var(--radius-lg)}.search-empty>span{color:var(--gold);font-size:2.5rem}.search-empty h2{margin:.5rem;font:500 1.5rem var(--font-serif)}.search-empty p{color:var(--muted);font-size:.85rem}@media(max-width:820px){.search-panel{grid-template-columns:1fr 1fr}.query-label{grid-column:1/-1}.search-result a{grid-template-columns:1fr}.search-result strong{grid-column:1;grid-row:auto;margin-top:.75rem}}@media(max-width:520px){.search-panel{grid-template-columns:1fr}.query-label{grid-column:auto}.result-summary{flex-direction:column}}</style>
