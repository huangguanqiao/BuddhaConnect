---
import Base from '../../../layouts/Base.astro';
import {getCollection} from 'astro:content';
import {LOCALES,LOCALE_PATHS,localePrefix,UI,localizedEntry} from '../../../lib/site-i18n.mjs';
import {publishedArticlesForLocale,articleUrl} from '../../../lib/i18n.mjs';
export function getStaticPaths(){return LOCALES.map(locale=>({params:{locale:LOCALE_PATHS[locale as keyof typeof LOCALE_PATHS]},props:{language:locale}}));}
const {language}=Astro.props;const ui=UI[language as keyof typeof UI];
const articles=publishedArticlesForLocale((await getCollection('articles')).map(localizedEntry),language);
---
<Base locale={language} title={`${ui.articles} · BuddhaConnect`}>
<section class="section"><div class="wrap"><h1 class="serif">{ui.articles}</h1><p>{ui.intro}</p><label for="article-search">{ui.search}</label><input id="article-search" type="search" placeholder={ui.search} aria-label={ui.search}/><p id="search-empty" hidden>{ui.noResults}</p><div class="article-grid" id="articles">{articles.map((a: any)=><a class="tile" href={articleUrl(a)} data-search={`${a.title} ${a.description} ${a.category}`.toLocaleLowerCase()}><p class="eyebrow">{a.category}</p><h2>{a.title}</h2><p>{a.description}</p><span>{ui.read} ↗</span></a>)}</div>{articles.length===0&&<p>{ui.empty}</p>}</div></section>
</Base>
<script>
const input=document.querySelector<HTMLInputElement>('#article-search');
input?.addEventListener('input',()=>{
 const q=(input.value??'').trim().toLocaleLowerCase();let visible=0;
 document.querySelectorAll<HTMLElement>('#articles [data-search]').forEach(item=>{const match=item.getAttribute('data-search')?.includes(q)??false;item.hidden=!match;if(match)visible++;});
 const empty=document.querySelector<HTMLElement>('#search-empty');if(empty)empty.hidden=visible!==0;
});
</script>
<style>.article-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px;margin-top:28px}.tile{padding:24px;border:1px solid #deded5}.tile[hidden]{display:none}.tile h2{font-size:1.5rem;margin:10px 0}.tile p{line-height:1.8}input{display:block;max-width:480px;width:100%;padding:12px;border:1px solid #aaa;margin-top:12px}label{display:block;margin-top:24px}</style>
