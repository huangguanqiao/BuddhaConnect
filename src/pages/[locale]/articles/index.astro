---
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import PageHero from '../../../components/PageHero.astro';
import ContentCard from '../../../components/ContentCard.astro';
import EmptyState from '../../../components/EmptyState.astro';
import { getCollection } from 'astro:content';
import { LOCALES, LOCALE_PATHS, PAGE_CONTENT, UI, localizedEntry, localizedPath, translationLinksFor } from '../../../lib/site-i18n.mjs';
import { publishedArticlesForLocale } from '../../../lib/i18n.mjs';
export function getStaticPaths() { return (LOCALES as Array<keyof typeof LOCALE_PATHS>).map((locale) => ({ params:{locale:LOCALE_PATHS[locale]}, props:{language:locale} })); }
const language = Astro.props.language as keyof typeof UI;
const ui = UI[language]; const page = PAGE_CONTENT[language].articles;
const articles: any[] = publishedArticlesForLocale((await getCollection('articles')).map(localizedEntry),language).sort((a:any,b:any)=>b.date.valueOf()-a.date.valueOf());
const categories: string[] = [...new Set<string>(articles.map((article:any)=>String(article.category)))].sort();
---
<Base locale={language} title={`${page.title} · BuddhaConnect`} description={page.description} translationLinks={translationLinksFor('articles')}>
  <Breadcrumbs locale={language} items={[{label:ui.home,href:localizedPath(language)},{label:ui.articles}]}/><PageHero eyebrow={page.eyebrow} title={page.title} description={page.description} compact/>
  <section class="section"><div class="wrap">{articles.length ? <><div class="collection-tools"><p><strong>{articles.length}</strong> {ui.results}</p><div aria-label={ui.category}><a class="filter active" href={localizedPath(language,'articles')}>{ui.all}</a>{categories.map((category:string)=><a class="filter" href={`${localizedPath(language,'search')}?category=${encodeURIComponent(category)}`}>{category}</a>)}</div><a class="text-link" href={localizedPath(language,'search')}>{ui.search} <span aria-hidden="true">⌕</span></a></div><div class="article-grid">{articles.map((article:any)=><ContentCard article={article} label={ui.read} locale={language}/>)}</div></> : <EmptyState title={ui.empty} description={ui.searchHint} href={localizedPath(language)} action={ui.home}/>}</div></section>
</Base>
<style>.collection-tools{display:flex;align-items:center;gap:1rem;justify-content:space-between;margin-bottom:2rem}.collection-tools p{margin:0;color:var(--muted);font-size:.8rem}.collection-tools p strong{color:var(--ink)}.collection-tools div{display:flex;gap:.5rem;flex-wrap:wrap;justify-content:center}.filter{padding:.5rem .8rem;border:1px solid var(--line);border-radius:999px;color:var(--muted);font-size:.75rem}.filter:hover,.filter.active{background:var(--pine);border-color:var(--pine);color:white}@media(max-width:760px){.collection-tools{align-items:flex-start;flex-direction:column}.collection-tools div{justify-content:flex-start}}</style>
