---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PageHero from '../../components/PageHero.astro';
import ContentCard from '../../components/ContentCard.astro';
import EmptyState from '../../components/EmptyState.astro';
import { getCollection } from 'astro:content';
import { LOCALES, LOCALE_PATHS, PAGE_CONTENT, UI, localizedEntry, localizedPath, translationLinksFor } from '../../lib/site-i18n.mjs';
import { publishedArticlesForLocale } from '../../lib/i18n.mjs';

const SECTIONS = ['start','teachings','practice','about'] as const;
export function getStaticPaths() { return (LOCALES as Array<keyof typeof LOCALE_PATHS>).flatMap((locale) => ['start','teachings','practice','about'].map((section) => ({ params:{ locale:LOCALE_PATHS[locale], section }, props:{ language:locale, section } }))); }
const language = Astro.props.language as keyof typeof UI;
const section = Astro.props.section as typeof SECTIONS[number];
const ui = UI[language];
const page: any = PAGE_CONTENT[language][section];
const articles: any[] = publishedArticlesForLocale((await getCollection('articles')).map(localizedEntry), language).filter((article:any) => article.section === section).sort((a:any,b:any) => b.date.valueOf() - a.date.valueOf());
const crumbs = [{ label:ui.home, href:localizedPath(language) }, { label:ui[section] }];
---
<Base locale={language} title={`${page.title} · BuddhaConnect`} description={page.description} translationLinks={translationLinksFor(section)}>
  <Breadcrumbs locale={language} items={crumbs}/><PageHero eyebrow={page.eyebrow} title={page.title} description={page.description} compact={section === 'about'}/>
  {section === 'about' ? (
    <section class="section"><div class="wrap about-grid"><div><p class="eyebrow">{page.intro}</p><h2>{page.title}</h2></div><div class="about-copy">{page.paragraphs.map((paragraph:string) => <p>{paragraph}</p>)}<aside class="notice"><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 10v6M12 7h.01"/></svg><span>{ui.editorialText}</span></aside></div></div></section>
  ) : (
    <section class="section"><div class="wrap"><div class="section-head"><div><p class="eyebrow">{page.intro}</p><h2>{ui.articles}</h2></div></div><aside class="notice"><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 10v6M12 7h.01"/></svg><span>{page.note}</span></aside>{articles.length ? <div class="article-grid">{articles.map((article:any) => <ContentCard article={article} label={ui.read} locale={language}/>)}</div> : <EmptyState title={ui.empty} description={ui.searchHint} href={localizedPath(language,'articles')} action={ui.browse}/>}</div></section>
  )}
</Base>
<style>.about-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:clamp(2.5rem,8vw,7rem)}.about-grid h2{margin:.75rem 0;font:500 clamp(2rem,4vw,3.4rem)/1.3 var(--font-serif)}.about-copy{max-width:43rem;color:var(--muted);font-size:1.02rem;line-height:2}.about-copy p{margin:0 0 1.25rem}@media(max-width:760px){.about-grid{grid-template-columns:1fr}}</style>
