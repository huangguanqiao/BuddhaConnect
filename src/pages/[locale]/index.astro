---
import Base from '../../layouts/Base.astro';
import ContentCard from '../../components/ContentCard.astro';
import EmptyState from '../../components/EmptyState.astro';
import { getCollection } from 'astro:content';
import { LOCALES, LOCALE_PATHS, PAGE_CONTENT, UI, localizedEntry, localizedPath, translationLinksFor } from '../../lib/site-i18n.mjs';
import { publishedArticlesForLocale } from '../../lib/i18n.mjs';

export function getStaticPaths() { return (LOCALES as Array<keyof typeof LOCALE_PATHS>).map((locale) => ({ params: { locale: LOCALE_PATHS[locale] }, props: { language: locale } })); }
const language = Astro.props.language as keyof typeof UI;
const ui = UI[language];
const page = PAGE_CONTENT[language].home;
const articles: any[] = publishedArticlesForLocale((await getCollection('articles')).map(localizedEntry), language).sort((a:any,b:any) => b.date.valueOf() - a.date.valueOf()).slice(0,3);
const paths: Array<{key:keyof typeof ui;marker:string;text:string}> = [
  { key:'start', marker:'01', text:PAGE_CONTENT[language].start.description },
  { key:'teachings', marker:'02', text:PAGE_CONTENT[language].teachings.description },
  { key:'practice', marker:'03', text:PAGE_CONTENT[language].practice.description },
];
const heroAlt = language === 'en' ? 'Original illustration of sunrise over quiet green mountains' : language === 'zh-TW' ? '旭日照耀寧靜綠色山巒的原創插畫' : '旭日照耀宁静绿色山峦的原创插画';
---
<Base locale={language} title={`BuddhaConnect · ${page.title}`} description={page.description} translationLinks={translationLinksFor('home')}>
  <section class="home-hero">
    <div class="wrap hero-grid">
      <div class="hero-copy"><p class="eyebrow">{page.eyebrow}</p><h1>{page.title}</h1><p>{page.description}</p><div class="hero-actions"><a class="button" href={localizedPath(language,'start')}>{page.primary} <span aria-hidden="true">↗</span></a><a class="button button-secondary" href={localizedPath(language,'articles')}>{page.secondary}</a></div></div>
      <figure><img src="/images/hero-mountains.svg" width="1200" height="740" alt={heroAlt}/><figcaption>BuddhaConnect · {page.values[0][0]} · {page.values[1][0]} · {page.values[2][0]}</figcaption></figure>
    </div>
  </section>
  <section class="value-strip"><div class="wrap">{page.values.map(([title,text]:string[],index:number) => <div><span>0{index+1}</span><p><strong>{title}</strong>{text}</p></div>)}</div></section>
  <section class="section"><div class="wrap"><div class="section-head"><div><p class="eyebrow">{page.exploreEyebrow}</p><h2>{page.exploreTitle}</h2><p>{page.exploreDescription}</p></div></div><div class="path-grid">{paths.map((item) => <a href={localizedPath(language,item.key)}><span>{item.marker}</span><h3>{ui[item.key]}</h3><p>{item.text}</p><i aria-hidden="true">↗</i></a>)}</div></div></section>
  <section class="section section-soft"><div class="wrap"><div class="section-head"><div><p class="eyebrow">{page.latestEyebrow}</p><h2>{page.latestTitle}</h2><p>{page.latestDescription}</p></div><a class="text-link" href={localizedPath(language,'articles')}>{ui.browse} <i aria-hidden="true">↗</i></a></div>{articles.length ? <div class="article-grid">{articles.map((article:any) => <ContentCard article={article} label={ui.read} locale={language}/>)}</div> : <EmptyState title={ui.empty} description={ui.footerNote} href={localizedPath(language,'about')} action={ui.about}/>}</div></section>
</Base>
<style>
  .home-hero{padding:clamp(2.5rem,6vw,5.5rem) 0 clamp(4rem,8vw,7rem);background:radial-gradient(circle at 76% 15%,#ecdfc5 0,transparent 33%),var(--canvas)}.hero-grid{display:grid;grid-template-columns:1.02fr .98fr;align-items:center;gap:clamp(2.5rem,7vw,6rem)}.hero-copy h1{max-width:43rem;margin:1rem 0 1.4rem;font:500 clamp(3rem,6vw,5.8rem)/1.18 var(--font-serif);letter-spacing:-.045em;text-wrap:balance}.hero-copy>p:not(.eyebrow){max-width:38rem;color:var(--muted);font-size:1.05rem;line-height:2}.hero-actions{display:flex;flex-wrap:wrap;gap:.8rem;margin-top:2rem}.home-hero figure{position:relative;margin:0;padding:1rem 1rem 3rem;border:1px solid #d7d7ca;border-radius:45% 45% var(--radius-lg) var(--radius-lg);background:#e4dfd2;box-shadow:var(--shadow-md);overflow:hidden}.home-hero figure::after{content:"";position:absolute;inset:1rem 1rem 3rem;border-radius:44% 44% .5rem .5rem;box-shadow:inset 0 0 0 1px #ffffff70;pointer-events:none}.home-hero figure img{display:block;width:100%;min-height:31rem;object-fit:cover;border-radius:44% 44% .5rem .5rem}.home-hero figcaption{position:absolute;right:1.5rem;bottom:1.05rem;color:var(--muted);font-size:.65rem;letter-spacing:.1em;text-transform:uppercase}.value-strip{border-block:1px solid var(--line);background:var(--surface)}.value-strip>.wrap{display:grid;grid-template-columns:repeat(3,1fr)}.value-strip div div{display:flex;gap:1rem;padding:1.55rem 2rem;border-left:1px solid var(--line)}.value-strip div div:last-child{border-right:1px solid var(--line)}.value-strip span{color:var(--gold);font:500 1.7rem var(--font-serif)}.value-strip p{margin:0;color:var(--muted);font-size:.78rem;line-height:1.6}.value-strip strong{display:block;color:var(--ink);font-size:.9rem}.path-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.path-grid a{position:relative;min-height:18rem;padding:2rem;border:1px solid var(--line);border-radius:var(--radius-lg);background:var(--surface);overflow:hidden;transition:.2s}.path-grid a:hover{border-color:var(--sage-300);box-shadow:var(--shadow-md);transform:translateY(-3px)}.path-grid span{color:var(--gold);font:500 2rem var(--font-serif)}.path-grid h3{margin:3.5rem 0 .8rem;font:500 1.55rem var(--font-serif)}.path-grid p{margin:0;color:var(--muted);font-size:.88rem;line-height:1.8}.path-grid i{position:absolute;right:1.5rem;top:1.5rem;font-style:normal;color:var(--pine)}
  @media(max-width:900px){.hero-grid{grid-template-columns:1fr}.home-hero figure img{min-height:22rem}.value-strip>.wrap{grid-template-columns:1fr}.value-strip div div,.value-strip div div:last-child{border-right:1px solid var(--line);border-bottom:1px solid var(--line)}.path-grid{grid-template-columns:1fr}.path-grid a{min-height:auto}.path-grid h3{margin-top:1.5rem}}@media(max-width:520px){.home-hero figure{padding:.65rem .65rem 2.7rem}.home-hero figure::after{inset:.65rem .65rem 2.7rem}.home-hero figure img{min-height:17rem}.hero-copy h1{font-size:clamp(2.7rem,14vw,4rem)}}
</style>
