---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
const articles=(await getCollection('articles')).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf()).slice(0,3);
---
<Base><section class="hero"><div class="wrap hero-grid"><div class="hero-copy"><p class="eyebrow">BUDDHACONNECT · 佛教文化与生活</p><h1 class="serif">于纷繁世界中，<br/><em>寻一份清明。</em></h1><div class="line"></div><p class="intro">不必远离日常，也能亲近智慧。<br/>从一篇文章、一段经典、一刻静心开始，<br/>慢慢探索佛法与生活的连接。</p><div class="actions"><a class="button" href="/start/">从这里开始　↗</a><a class="button button-outline" href="/articles/">阅读文章</a><a class="button button-outline" href="/zh/search/">搜索文章 ↗</a></div></div><div class="hero-art" role="img" aria-label="山峦与旭日原创插画"><div class="sun"></div><div class="mountain m1"></div><div class="mountain m2"></div><div class="mountain m3"></div><span class="art-caption">心静 · 见远</span></div></div></section>
<section class="section"><div class="wrap"><div class="center"><p class="eyebrow">EXPLORE · 探索</p><h2 class="section-title serif">从好奇开始，向内心走去</h2><p class="muted">无论你刚刚接触佛教，还是希望重新认识经典，都可以从这里找到自己的路径。</p></div><div class="features"><a class="tile" href="/start/"><span class="feature-num">01 / BEGIN</span><span class="feature-icon">◌</span><h3 class="serif">佛学入门</h3><p>用平实的语言，理解佛教的基本观念与生活智慧。</p><span class="feature-link">开始了解 ↗</span></a><a class="tile" href="/classics/"><span class="feature-num">02 / READ</span><span class="feature-icon">☷</span><h3 class="serif">佛教经典</h3><p>慢读经文，了解背景、译意与值得思考的内容。</p><span class="feature-link">走近经典 ↗</span></a><a class="tile" href="/glossary/"><span class="feature-num">03 / LEARN</span><span class="feature-icon">✳</span><h3 class="serif">佛教词典</h3><p>从缘起到慈悲，把常见概念讲得清楚、易懂。</p><span class="feature-link">探索词条 ↗</span></a></div></div></section>
<section class="quote"><div class="wrap"><p class="eyebrow">A MOMENT OF STILLNESS</p><p class="serif quote-text">放慢一点，<br/>也许就能看见更多。</p><p>给自己留一段安静的时间，从此刻开始。（回滚测试）</p></div></section>
<section class="section"><div class="wrap"><div class="section-head"><div><p class="eyebrow">JOURNAL · 文章</p><h2 class="section-title serif">最新阅读</h2></div><a href="/articles/">全部文章 ↗</a></div><div class="article-grid">{articles.map((article,i)=><a href={`/articles/${article.id}/`} class="tile article-card"><span class="feature-num">0{i+1} · {article.data.category}</span><h3 class="serif">{article.data.title}</h3><p>{article.data.description}</p><span class="feature-link">阅读全文 ↗</span></a>)}</div></div></section>
<section class="end-cta"><div class="wrap"><p class="eyebrow">BEGIN YOUR JOURNEY</p><h2 class="serif">智慧不在远方，就在此刻。</h2><a class="button" href="/start/">开启阅读之旅 ↗</a></div></section>
</Base>
<style>.hero{padding:64px 0 86px;background:#f3f2eb}.hero-grid{display:grid;grid-template-columns:1.08fr .92fr;align-items:center;gap:65px}.hero-copy{padding:45px 0}.hero h1{font-weight:500;font-size:clamp(3rem,5.2vw,5.25rem);line-height:1.4;letter-spacing:.02em;margin:23px 0}.hero h1 em{font-style:normal;color:#a38a62}.intro{color:#68766b;line-height:2.2;font-size:1.02rem}.actions{display:flex;gap:14px;flex-wrap:wrap;margin-top:33px}.hero-art{min-height:500px;background:#cbd7c9 url("/images/hero-mountains.svg") center/cover no-repeat;position:relative;overflow:hidden;border-radius:48% 48% 3px 3px}.hero-art .sun,.hero-art .mountain{display:none}.sun{width:190px;height:190px;border-radius:50%;background:#f2dfb5;position:absolute;top:80px;left:50%;transform:translateX(-50%);box-shadow:0 0 90px #f2dfb555}.mountain{position:absolute;bottom:-70px;width:120%;height:310px;left:-10%;border-radius:50% 50% 0 0}.m1{background:#b3c2b1;bottom:15px;transform:rotate(-14deg);left:-32%}.m2{background:#819b8b;bottom:-80px;transform:rotate(13deg);left:20%}.m3{background:#456b5c;bottom:-160px;transform:rotate(-8deg);left:-32%}.art-caption{position:absolute;bottom:35px;right:35px;color:#f7f5ec;letter-spacing:.35em;font-size:.82rem}.center{text-align:center}.center .muted{max-width:700px;margin:18px auto 0;line-height:1.9}.features,.article-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:45px}.feature-num{font-size:.68rem;letter-spacing:.16em;color:#a48a64;font-weight:700}.feature-icon{display:block;font-family:serif;font-size:3rem;color:#9aa99a;margin:30px 0 12px}.tile h3{font-size:1.6rem;font-weight:500;margin:14px 0}.tile p{font-size:.9rem;line-height:1.9;color:#748078}.feature-link{display:inline-block;margin-top:20px;color:#315d4b;font-size:.85rem}.quote{background:#e5eae3;text-align:center;padding:85px 0}.quote-text{font-size:clamp(2.4rem,4.5vw,4rem);line-height:1.65;margin:25px 0;color:#345546}.quote p:last-child{color:#738075}.section-head{display:flex;justify-content:space-between;align-items:end}.section-head a{font-size:.85rem;color:#315d4b}.article-card{min-height:240px}.end-cta{text-align:center;background:#eee9dd;padding:90px 0}.end-cta h2{font-size:clamp(2rem,4vw,3.4rem);font-weight:500;margin:20px 0 32px}@media(max-width:800px){.hero-grid{grid-template-columns:1fr;gap:0}.hero-art{min-height:360px}.features,.article-grid{grid-template-columns:1fr}.hero{padding:35px 0 60px}.hero-copy{padding:15px 0 40px}}
</style>
