---
import Redirect from '../../components/Redirect.astro';
import { getCollection } from 'astro:content';
import { articleUrl } from '../../lib/i18n.mjs';
import { localizedEntry } from '../../lib/site-i18n.mjs';
export async function getStaticPaths(){ const entries=await getCollection('articles'); return entries.filter((entry)=>entry.data.published).map((entry)=>({params:{slug:entry.id},props:{to:articleUrl(localizedEntry(entry)),title:entry.data.title}})); }
const { to, title }=Astro.props;
---
<Redirect to={to} title={`${title} · BuddhaConnect`} />
