---
import Base from '../../layouts/Base.astro';import PageHeading from '../../components/PageHeading.astro';import {getCollection} from 'astro:content';
const articles=(await getCollection('articles')).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
---
<Base title="文章 · BuddhaConnect"><PageHeading eyebrow="JOURNAL" title="文章与生活智慧" description="从日常困惑到经典思想，用容易理解的语言，一点点走近佛法。"/><section class="section"><div class="wrap grid">{articles.map(article=><a class="tile" href={`/articles/${article.id}/`}><p class="eyebrow">{article.data.category} · {article.data.date.toLocaleDateString('zh-CN')}</p><h2 class="serif">{article.data.title}</h2><p class="muted">{article.data.description}</p><span class="more">阅读文章 ↗</span></a>)}</div></section></Base>
<style>.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:22px}.tile h2{font-size:1.6rem;font-weight:500;margin:20px 0}.tile p{line-height:1.9}.more{display:block;margin-top:30px;color:#37624e}@media(max-width:700px){.grid{grid-template-columns:1fr}}</style>
