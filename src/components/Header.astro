---
import LanguageMenu from './LanguageMenu.astro';
import { PRIMARY_NAV, UI, localizedPath } from '../lib/site-i18n.mjs';
type Locale = keyof typeof UI;
interface Props { locale: Locale; currentPath: string; languageLinks: Array<{locale:Locale;url:string;fallback?:boolean}> }
const { locale, currentPath, languageLinks } = Astro.props;
const ui = UI[locale];
const navSections = PRIMARY_NAV as Array<keyof typeof ui>;
const isActive = (section: string) => section === 'home' ? currentPath === localizedPath(locale) : currentPath.startsWith(localizedPath(locale, section));
---
<header class="site-header" data-site-header>
  <div class="wrap header-inner">
    <a class="brand" href={localizedPath(locale)} aria-label={`BuddhaConnect · ${ui.home}`}>
      <img src="/images/lotus-mark.svg" width="42" height="42" alt="" />
      <span>Buddha<i>Connect</i></span>
    </a>
    <nav class="desktop-nav" aria-label={ui.menu}>
      {navSections.map((section) => <a href={localizedPath(locale, section)} aria-current={isActive(section) ? 'page' : undefined}>{ui[section]}</a>)}
    </nav>
    <div class="header-tools">
      <a class="search-link" href={localizedPath(locale, 'search')} aria-label={ui.search} aria-current={isActive('search') ? 'page' : undefined}>
        <svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m16 16 5 5"/></svg><span>{ui.search}</span>
      </a>
      <LanguageMenu locale={locale} links={languageLinks} />
      <button class="mobile-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-mobile-toggle><span></span><span></span><span></span><b class="sr-only">{ui.menu}</b></button>
    </div>
  </div>
  <nav id="mobile-menu" class="mobile-nav" aria-label={ui.menu} hidden data-mobile-menu>
    <div class="wrap">
      {navSections.map((section) => <a href={localizedPath(locale, section)} aria-current={isActive(section) ? 'page' : undefined}>{ui[section]}<span aria-hidden="true">↗</span></a>)}
      <a href={localizedPath(locale, 'search')}><strong>{ui.search}</strong><span aria-hidden="true">⌕</span></a>
    </div>
  </nav>
</header>
<script>
  document.querySelectorAll<HTMLElement>('[data-site-header]').forEach((header) => {
    const button = header.querySelector<HTMLButtonElement>('[data-mobile-toggle]');
    const menu = header.querySelector<HTMLElement>('[data-mobile-menu]');
    const close = (restore = false) => { if (!button || !menu) return; menu.hidden = true; button.setAttribute('aria-expanded','false'); document.body.classList.remove('menu-open'); if (restore) button.focus(); };
    const open = () => { if (!button || !menu) return; menu.hidden = false; button.setAttribute('aria-expanded','true'); document.body.classList.add('menu-open'); menu.querySelector<HTMLAnchorElement>('a')?.focus(); };
    button?.addEventListener('click', () => menu?.hidden ? open() : close());
    document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && menu && !menu.hidden) close(true); });
    window.addEventListener('resize', () => { if (window.innerWidth >= 1040) close(); });
  });
</script>
<style>
  .site-header{position:sticky;top:0;z-index:20;background:color-mix(in srgb,var(--canvas) 92%,transparent);border-bottom:1px solid color-mix(in srgb,var(--line) 82%,transparent);backdrop-filter:blur(14px)}.header-inner{min-height:5rem;display:flex;align-items:center;gap:1.5rem}.brand{display:inline-flex;align-items:center;gap:.65rem;flex-shrink:0;font-family:var(--font-serif);font-size:1.2rem;font-weight:700;letter-spacing:-.035em}.brand img{width:2.35rem;height:2.35rem}.brand i{font-weight:400;font-style:normal}.desktop-nav{display:flex;align-items:center;justify-content:center;gap:clamp(.75rem,1.5vw,1.5rem);margin-inline:auto}.desktop-nav a{position:relative;padding:1.85rem 0 1.7rem;color:var(--muted);font-size:.8rem;white-space:nowrap}.desktop-nav a::after{content:"";position:absolute;left:0;right:100%;bottom:1.25rem;height:1px;background:var(--gold);transition:right .2s ease}.desktop-nav a:hover,.desktop-nav a[aria-current=page]{color:var(--pine)}.desktop-nav a[aria-current=page]::after{right:0}.header-tools{display:flex;align-items:center;gap:.65rem}.search-link{display:flex;align-items:center;gap:.4rem;color:var(--muted);font-size:.78rem}.search-link:hover,.search-link[aria-current=page]{color:var(--pine)}.search-link svg{width:1.15rem;height:1.15rem;fill:none;stroke:currentColor;stroke-width:1.6}.mobile-toggle{display:none;width:2.6rem;height:2.6rem;border:1px solid var(--line);border-radius:50%;background:var(--surface);align-items:center;justify-content:center;flex-direction:column;gap:4px;cursor:pointer}.mobile-toggle span{display:block;width:1rem;height:1px;background:var(--ink)}.mobile-nav{background:var(--canvas);border-top:1px solid var(--line)}.mobile-nav[hidden]{display:none}.mobile-nav .wrap{display:grid;padding-block:.75rem 1.25rem}.mobile-nav a{display:flex;align-items:center;justify-content:space-between;padding:1rem 0;border-bottom:1px solid var(--line);font-family:var(--font-serif);font-size:1.1rem}.mobile-nav a[aria-current=page]{color:var(--gold-dark)}
  @media(max-width:1039px){.desktop-nav{display:none}.header-inner{min-height:4.5rem}.header-tools{margin-left:auto}.mobile-toggle{display:flex}}@media(max-width:620px){.search-link span{display:none}}@media(max-width:480px){.search-link{display:none}.brand{font-size:1rem}.brand img{width:2rem;height:2rem}.header-inner{gap:.75rem}.header-tools{gap:.45rem}}
</style>
